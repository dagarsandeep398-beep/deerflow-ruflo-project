# Example environment variables for a local self-hosted run.
# Copy this file to .env and fill in the values you need.

# Core agent settings
AGENT_MODE=paper
DEFAULT_LANGUAGE=hi
LIVE_MODE_ENABLED=false
MAX_TRADE_ALLOCATION_PCT=2.0
MAX_DAILY_LOSS_PCT=2.0
PORT=8000

# Optional broker API keys - do not commit real secrets.
# These remain disabled until you explicitly turn on live mode.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
OANDA_API_KEY=
OANDA_ACCOUNT_ID=

# Optional voice / WhatsApp / LLM keys
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
USER_WHATSAPP_NUMBER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
